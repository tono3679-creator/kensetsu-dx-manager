# =============================================================================
# 建設DX Manager 環境変数
#   cp .env.example .env.local で作成してください（.env.local は Git 管理外）
# =============================================================================

# 動作モード
#   demo     : 既定。PGlite（WASM 版 PostgreSQL）をアプリ内で起動。Supabase 不要
#   supabase : Supabase（Auth + PostgreSQL + Storage）に接続
APP_MODE=demo

# デモモードのセッション署名キー（32文字以上のランダム文字列）
#   未設定の場合、開発時は固定値・本番時は起動ごとのランダム値を使用します
#   生成例: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# デモモードのデータ保存先（未指定ならメモリ上。再起動・日付変更で初期データに戻る）
# DEMO_DATA_DIR=./.data/pglite

# -----------------------------------------------------------------------------
# APP_MODE=supabase のときに必要（Supabase ダッシュボード > Project Settings）
# -----------------------------------------------------------------------------
# Project URL / anon (public) key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key（サーバー専用。写真ストレージ操作と Seed スクリプトで使用。絶対に公開しないこと）
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL 接続文字列（Connect > Transaction pooler 推奨）
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# -----------------------------------------------------------------------------
# 公開デモとして運用する場合（任意）
#   ログイン画面にデモアカウントを表示し、/api/cron/reset-demo で毎日デモデータを初期化する
#   Vercel では CRON_SECRET を設定すると Cron 実行時に Authorization ヘッダーが自動付与される
# -----------------------------------------------------------------------------
# DEMO_RESET_ENABLED=true
# CRON_SECRET=
